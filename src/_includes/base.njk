<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{ seoTitle or (title + " — a quiet room") }}</title>
  <meta name="description" content="{{ description }}" />
  <meta name="theme-color" content="#08080c" />
  <link rel="icon" href="{{ site.favicon or '/favicon.svg' }}" />
  <script>
    // apply the saved theme before paint so there's no flash
    try { document.documentElement.dataset.theme = localStorage.getItem("qr_site_theme") || "dark"; } catch (e) {}
  </script>
  <meta property="og:type" content="{{ ogType or 'website' }}" />
  <meta property="og:title" content="{{ ogTitle or seoTitle or title }}" />
  <meta property="og:description" content="{{ ogDescription or description }}" />
  <meta property="og:image" content="/og-image.png" />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="alternate" type="application/rss+xml" title="a quiet room" href="/feed.xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;1,400&family=Inter:wght@300;400&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/style.css?v={{ assetVersion }}" />
</head>
<body>
  <canvas id="ambient"></canvas>
  <div class="atmosphere" aria-hidden="true">
    <div class="grain"></div>
    <div class="vignette"></div>
  </div>

  <!-- Everything inside #swup is swapped on navigation; the shell (canvas,
       atmosphere, sound) persists so the music never stops. -->
  <div id="swup">
    {% if header != false %}
    <header class="site-head">
      <a href="/home/" class="mark">a quiet room</a>
      <nav class="nav" aria-label="Primary">
        <a href="/journal/"{% if nav == "journal" %} aria-current="page"{% endif %}>journal</a>
        <a href="/projects/"{% if nav == "projects" %} aria-current="page"{% endif %}>projects</a>
        <a href="/about/"{% if nav == "about" %} aria-current="page"{% endif %}>about</a>
        {%- if sitepages %}{% for cp in sitepages %}{% if cp.nav %}
        <a href="/{{ cp.slug }}/"{% if nav == cp.slug %} aria-current="page"{% endif %}>{{ cp.title }}</a>
        {%- endif %}{% endfor %}{% endif %}
      </nav>
    </header>
    {% endif %}

    {{ content | safe }}

    {% if footer != false %}
    <footer class="site-foot">
      <span>a quiet room</span>
      <a href="/home/">a portal to my innerworld</a>
    </footer>
    {% endif %}
  </div>

  <button id="site-theme-toggle" class="site-theme-toggle" aria-label="Switch between light and dark" title="Theme">
    <svg class="st-icon st-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" aria-hidden="true">
      <circle cx="12" cy="12" r="4.1" />
      <line x1="12" y1="2.6" x2="12" y2="5" />
      <line x1="12" y1="19" x2="12" y2="21.4" />
      <line x1="2.6" y1="12" x2="5" y2="12" />
      <line x1="19" y1="12" x2="21.4" y2="12" />
      <line x1="5.35" y1="5.35" x2="7.05" y2="7.05" />
      <line x1="16.95" y1="16.95" x2="18.65" y2="18.65" />
      <line x1="5.35" y1="18.65" x2="7.05" y2="16.95" />
      <line x1="16.95" y1="7.05" x2="18.65" y2="5.35" />
    </svg>
    <svg class="st-icon st-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M20.2 14.1A8.1 8.1 0 1 1 9.9 3.8a6.6 6.6 0 0 0 10.3 10.3Z" />
    </svg>
  </button>

  <div id="sound-shell" class="skiper-toggle" aria-label="Ambient sound player">
    <span class="sk-reveal">
      <button type="button" class="sk-mini" id="sk-list-btn" aria-label="Track list" title="Track list">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><line x1="4" y1="7" x2="20" y2="7"/><line x1="4" y1="12" x2="20" y2="12"/><line x1="4" y1="17" x2="13" y2="17"/></svg>
      </button>
      <button type="button" class="sk-mini" id="sk-prev" aria-label="Previous track" title="Previous track">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 5l-8 7 8 7"/><line x1="6.5" y1="5" x2="6.5" y2="19"/></svg>
      </button>
      <span class="sk-title-wrap">
        <span class="sk-ticker" id="sk-ticker">
          <span class="sk-title" id="sk-title">{{ soundtrack.tracks[0].title if soundtrack.tracks and soundtrack.tracks.length else "ambient" }}</span>
        </span>
      </span>
      <button type="button" class="sk-mini" id="sk-next" aria-label="Next track" title="Next track">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 5l8 7-8 7"/><line x1="17.5" y1="5" x2="17.5" y2="19"/></svg>
      </button>
    </span>
    <button type="button" id="sound-toggle" class="sk-knob" aria-pressed="false" aria-label="Play or pause ambient sound" title="Ambient sound">
      <svg class="sk-play" viewBox="-1 0 12 14" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M0.9375 13.2422C1.25 13.2422 1.51562 13.1172 1.82812 12.9375L10.9375 7.67188C11.5859 7.28906 11.8125 7.03906 11.8125 6.625C11.8125 6.21094 11.5859 5.96094 10.9375 5.58594L1.82812 0.3125C1.51562 0.132812 1.25 0.015625 0.9375 0.015625C0.359375 0.015625 0 0.453125 0 1.13281V12.1172C0 12.7969 0.359375 13.2422 0.9375 13.2422Z"/></svg>
      <span class="sk-eq" aria-hidden="true"><i></i><i></i><i></i></span>
    </button>
  </div>
  <div id="sk-list" class="sk-list" aria-label="Soundtrack"></div>

  <script id="soundtrack" type="application/json">{{ soundtrack.tracks | dump | safe }}</script>
  <script src="/js/main.js?v={{ assetVersion }}"></script>
</body>
</html>
