---
layout: base
nav: contact
permalink: /contact/
footer: false
seoTitle: "contact — a quiet room"
ogTitle: "contact — a quiet room"
description: "A living QR code that keeps the hour — scan it and it finds me."
---
<main class="qrtree-hero"{% if not (qrtree and qrtree.settings) %} hidden{% endif %}>
  <div class="qrtree-stage" data-qrtree></div>
  <div class="qrtree-overlay" data-reveal="0">
    <p class="eyebrow">{{ qrtree.eyebrow or "contact" }}</p>
    <h1>{{ qrtree.heading or "a code to keep" }}</h1>
    <p class="qrtree-lede">{{ qrtree.lede or "A small landscape that folds into a QR code — tap it, scan it, and it finds me." }}</p>
  </div>
  <button type="button" class="qrtree-download" data-qrtree-download>↓ keep the flat code</button>
  <script data-qrtree-config type="application/json">{{ qrtree | dump | safe }}</script>
</main>
